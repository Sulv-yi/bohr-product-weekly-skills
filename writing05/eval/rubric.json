          "id": "method_improvement",
          "name": "方法改进",
          "weight": 5,
          "acceptance": "规则化的强度分级（研究设计词 + 样本量线索 + 复现线索）替代主观判断；表述强度与证据强度做机器校验。",
          "evidence": ["scripts/claim_split.py#DESIGN_RULES", "scripts/evidence_gate.py#hedge_alignment"],
          "auto_check": "python scripts/claim_split.py --quote \"随机对照试验，n=1200\" --claim \"该方案显著优于对照\" --grade"
        },
        {
          "id": "innovation_evidence",
          "name": "创新证据",
          "weight": 5,
          "acceptance": "相对基础 Agent / 通用写作工具的边界写清楚：能给到哪、给不到哪，并有对照报告。",
          "evidence": ["references/innovation-boundary.md", "examples/ab-report.md"],
          "auto_check": "test -f references/innovation-boundary.md"
        }
      ]
    },
    {
      "id": "reliability",
      "name": "可靠体验",
      "weight": 10,
      "items": [
