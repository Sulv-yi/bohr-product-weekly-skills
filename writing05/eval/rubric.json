      "name": "实际效果",
      "weight": 40,
      "items": [
        {
          "id": "task_completion",
          "name": "任务完成度",
          "weight": 15,
          "acceptance": "交付「论断清单—证据表—成稿」三段：成稿可直接进入修改流程，论断清单覆盖全文论断单元，证据表逐条给原文摘录与定位，不是规则文档或抽样示范。",
          "evidence": ["/app/output/draft.md", "/app/output/result.json#result.claims", "/app/output/evidence-table.md"],
          "auto_check": "python scripts/validate_result.py /app/output/result.json --case /input/case.json --text /app/output/draft.md"
        },
        {
          "id": "result_correctness",
          "name": "结果正确性",
          "weight": 15,
          "acceptance": "引用真实存在且著录准确；原文摘录确实支持对应论断；不把相关性写成因果、不把单篇小样本写成领域共识；材料外的事实一律不补。",
          "evidence": ["/app/output/claim-map.csv", "/app/output/result.json#sources", "/app/output/result.json#uncertainty"],
          "auto_check": "python eval/score_output.py --result /app/output/result.json --case /input/case.json --draft /app/output/draft.md --out /app/output/scorecard.json"
        },
        {
          "id": "result_completeness",
          "name": "结果完整性",
          "weight": 5,
          "acceptance": "四类要素齐备：论断单元、来源、证据强度标注、不确定性表述；冲突证据被列出或显式说明检索未见。",
          "evidence": ["/app/output/result.json#result.conflicts", "/app/output/selfcheck.md"],
          "auto_check": "python scripts/validate_result.py /app/output/result.json --case /input/case.json --text /app/output/draft.md"
        },
        {
          "id": "verifiability",
          "name": "结果可核验性",
          "weight": 5,
          "acceptance": "论断编号、原文摘录、定位（页/节/段）与强度理由四件齐备，第三方可逐条回查并复算；缺任一即不算可核验。",
          "evidence": ["/app/output/claim-map.csv", "/app/output/evidence-table.md"],
          "auto_check": "python scripts/build_outputs.py --result /app/output/result.json --draft /app/output/draft.md --outdir /app/output"
        }
      ]
    },
    {
      "id": "usage_gain",
      "name": "使用增益",
      "weight": 25,
      "items": [
        {
          "id": "quality_gain",
          "name": "质量增益",
          "weight": 15,
          "acceptance": "相同材料下，加载 Skill 后论断—来源绑定率、定位精度、强度标注与表述相称度严格优于基础 Agent；变差项必须如实列出。",
          "evidence": ["eval/ab-report.md", "examples/ab-report.md"],
