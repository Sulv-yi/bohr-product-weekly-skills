        },
        {
          "id": "efficiency_gain",
          "name": "效率增益",
          "weight": 5,
          "acceptance": "把回原文核对、补引用、改过度推断这三类返工前置到脚本判定，人工确认项数量不高于基线。",
          "evidence": ["/app/output/selfcheck.md", "eval/ab-protocol.md"],
          "auto_check": "python eval/compare_ab.py examples/baseline-scorecard.json examples/scorecard.json"
