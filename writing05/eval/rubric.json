          "evidence": ["eval/rubric.json", "eval/ab-protocol.md", "eval/acceptance.md"],
          "auto_check": "python eval/score_output.py --rubric eval/rubric.json --list"
        }
      ]
    },
    {
      "id": "innovation",
      "name": "创新增益",
      "weight": 15,
      "items": [
        {
          "id": "new_capability",
          "name": "新增能力",
          "weight": 5,
          "acceptance": "提供论断切分（claim_split）与强度判定（grade/hedge_ok）两个基础 Agent 不具备、且结果可复核的能力。",
