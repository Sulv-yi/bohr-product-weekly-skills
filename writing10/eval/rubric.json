          "auto_check": "python scripts/build_outputs.py --result /app/output/result.json --text /app/output/chapter.md --outdir /app/output"
        },
        {
          "id": "result_completeness",
          "name": "结果完整性",
          "weight": 5,
          "acceptance": "覆盖主指标、次要指标、安全性指标与阴性结果；不一致文献与局限被如实交代。",
          "auto_check": "python scripts/validate_result.py /app/output/result.json --case /input/case.json --text /app/output/chapter.md"
        },
        {
          "id": "verifiability",
          "name": "结果可核验性",
          "weight": 5,
